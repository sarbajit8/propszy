{
  "name": "propszy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Propszy real-estate platform — Express + Prisma (MySQL) API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node prisma/seed.js",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy && node prisma/seed.js",
    "backfill:commission": "node prisma/backfill-commission.js",
    "backfill:media": "node prisma/backfill-media.js",
    "backfill:categories": "node prisma/backfill-categories.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.16",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
