# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5050
API_PREFIX=/api
# Comma-separated list of allowed frontend origins:
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: serve pre-built frontend/dist directly from backend in single-tier deploy
# SERVE_FRONTEND=false

# ── Database (Standard MySQL / AWS RDS) ──────────────────
# Standard MySQL (Ubuntu EC2 / Debian / Local MySQL on standard port 3306):
DATABASE_URL="mysql://propszy_user:PropszySecure2026!@localhost:3306/propszy_re"

# AWS RDS MySQL (replace with your RDS endpoint, user, password, and port):
# DATABASE_URL="mysql://admin:YourRDSPassword@propszy-db.c9xxxx.us-east-1.rds.amazonaws.com:3306/propszy_re?sslaccept=strict"

# XAMPP MySQL fallback (if using Windows XAMPP on port 3307):
# DATABASE_URL="mysql://root:@localhost:3307/propszy_re"

# ── Auth & Cookies ─────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-strong-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-strong-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Set COOKIE_SECURE=false if testing in production over HTTP (raw IP) before SSL is installed:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax

# ── Integrations ───────────────────────────────────────
# All of these can also be set at runtime from Admin → Settings (stored in DB).
# Values here are only the fallback used until an admin saves them.
GOOGLE_MAPS_API_KEY=
GA_ID=

# ── Media storage ──────────────────────────────────────
# driver: local | s3 | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:5050
MAX_UPLOAD_MB=25

# S3 (when STORAGE_DRIVER=s3)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary (when STORAGE_DRIVER=cloudinary)
CLOUDINARY_URL=

# ── Email (SMTP / SendGrid) ────────────────────────────
MAIL_FROM="Propszy <no-reply@propszy.test>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── SMS / WhatsApp (optional) ──────────────────────────
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_API_URL=

# ── Seed admin ─────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@propszy.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Propszy Admin


# CREATE USER 'propszy'@'localhost' IDENTIFIED BY 'propszy2025';
# GRANT ALL PRIVILEGES ON propszy.* TO 'propszy'@'localhost';