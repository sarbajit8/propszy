# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5050
API_PREFIX=/api
CLIENT_ORIGIN=http://localhost:5173

# ── Database (XAMPP MySQL: default user root, empty password) ──
# NOTE: this XAMPP's MySQL listens on 3307 (see C:\xampp\mysql\bin\my.ini). Use your own port.
DATABASE_URL="mysql://root:@localhost:3307/propszy_re"

# ── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Integrations ───────────────────────────────────────
# All of these can also be set at runtime from Admin → Settings (stored in DB).
# Values here are only the fallback used until an admin saves them.
GOOGLE_MAPS_API_KEY=
GA_ID=

# ── Media storage ──────────────────────────────────────
# driver: local | s3 | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:5050
MAX_UPLOAD_MB=25

# S3 (when STORAGE_DRIVER=s3)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary (when STORAGE_DRIVER=cloudinary)
CLOUDINARY_URL=

# ── Email (SMTP / SendGrid) ────────────────────────────
MAIL_FROM="Propszy <no-reply@propszy.test>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── SMS / WhatsApp (optional) ──────────────────────────
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_API_URL=

# ── Seed admin ─────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@propszy.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Propszy Admin
