# ── Propszy Backend Production Environment Template ────────────────
# Copy this file to .env on your AWS EC2 server or container:
#   cp .env.production.example .env

# ── Environment & Network ──────────────────────────────────────────
NODE_ENV=production
PORT=5050
API_PREFIX=/api

# Allowed origins for CORS (comma-separated):
# Include your frontend domain(s) and/or EC2 public IP:
CLIENT_ORIGIN=https://propszy.com,https://www.propszy.com

# If using single-process deployment (serving frontend static build directly from Express):
SERVE_FRONTEND=false

# ── Database (MySQL 8 / AWS RDS) ───────────────────────────────────
# Standard local MySQL on EC2:
# DATABASE_URL="mysql://propszy_user:PropszySecure2026!@localhost:3306/propszy_re"
DATABASE_URL="mysql://propszy:propszy2025@localhost:3306/propszy"

# OR AWS RDS MySQL:
# DATABASE_URL="mysql://admin:YourRDSPassword@propszy-db.c9xxxx.us-east-1.rds.amazonaws.com:3306/propszy_re?sslaccept=strict"

# ── Security & Authentication ──────────────────────────────────────
# Generate secure 64-character random secrets (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-64-character-random-hex-string
JWT_REFRESH_SECRET=replace-with-another-64-character-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie Security:
# Set to 'true' once SSL (HTTPS) is active on your domain.
# If testing initially over raw HTTP IP, set to 'false' so browsers don't block refresh tokens.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ── Media Storage ──────────────────────────────────────────────────
# Option 1: Local disk storage on EC2 (default & easiest, served by Nginx or Express)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=https://propszy.com
MAX_UPLOAD_MB=50

# Option 2: AWS S3 Bucket
# STORAGE_DRIVER=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=propszy-media-bucket
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email Service (Production SMTP) ────────────────────────────────
MAIL_FROM="Propszy Real Estate <no-reply@propszy.com>"
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAXXXXXXXXXXXXXXXX
SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_SECURE=false

# ── Initial Admin Seed (Only used on first migration/seed) ─────────
SEED_ADMIN_EMAIL=admin@propszy.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin@2026!
SEED_ADMIN_NAME=Propszy Administrator
