# ── Frontend Development Environment ─────────────────────────
# When using Vite dev server (npm run dev), requests to /api and /uploads
# are automatically proxied to http://localhost:5050 as defined in vite.config.js.
VITE_API_URL=/api
VITE_UPLOADS_URL=/uploads

# Optional client-side API keys (can also be configured dynamically in Admin Settings):
VITE_GOOGLE_MAPS_KEY=
VITE_GA_ID=
