# ── Frontend Production Environment ─────────────────────────
# When deployed behind Nginx (standard AWS setup), use relative paths.
# Nginx routes / to frontend/dist, /api to Express backend, and /uploads to media files.
VITE_API_URL=/api
VITE_UPLOADS_URL=/uploads

# If frontend is hosted separately from backend (e.g. S3/CloudFront/Vercel):
# VITE_API_URL=https://api.propszy.com/api
# VITE_UPLOADS_URL=https://api.propszy.com/uploads

# Client-side API keys (fallback; can also be managed from Admin -> Settings):
VITE_GOOGLE_MAPS_KEY=
VITE_GA_ID=
